<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp"
    android:background="@drawable/update_dialog_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/update_icon"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:scaleType="centerCrop"
            android:src="@drawable/app_icon"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/update_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NEW UPDATE AVAILABLE"
                android:textColor="#FFF7D4"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/update_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:background="@drawable/update_dialog_chip"
                android:paddingLeft="11dp"
                android:paddingTop="5dp"
                android:paddingRight="11dp"
                android:paddingBottom="5dp"
                android:text="VERSION 1.0.11 • BUILD 12"
                android:textColor="#E7C75A"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="18dp"
        android:background="#35D4AF37" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="WHAT'S NEW"
        android:textColor="#D4AF37"
        android:textSize="13sp"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <TextView
        android:id="@+id/update_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#F4F0DF"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp"
        android:fontFamily="sans" />

    <TextView
        android:id="@+id/update_storage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="17dp"
        android:padding="12dp"
        android:background="@drawable/update_dialog_chip"
        android:text="✓ Your account data stays in the app and is not cleared by an update."
        android:textColor="#D9E7D1"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/update_later"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:text="LATER"
            android:textColor="#D4AF37"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/update_install"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:paddingLeft="18dp"
            android:paddingRight="18dp"
            android:text="DOWNLOAD &amp; INSTALL"
            android:textColor="#11100A"
            android:textSize="13sp"
            android:textStyle="bold"
            android:background="@drawable/update_dialog_chip" />
    </LinearLayout>
</LinearLayout>