<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="28dp"
    android:background="@drawable/update_dialog_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/update_icon"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            android:src="@drawable/app_icon"
            android:contentDescription="@string/app_name" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="18dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/update_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="NEW UPDATE AVAILABLE"
                android:textColor="#FFF7D4"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="sans"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/update_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/update_dialog_chip"
                android:paddingLeft="14dp"
                android:paddingTop="7dp"
                android:paddingRight="14dp"
                android:paddingBottom="7dp"
                android:text="VERSION 1.0.44 • BUILD 45"
                android:textColor="#E7C75A"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="20dp"
        android:background="#35D4AF37" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="WHAT'S NEW"
        android:textColor="#D4AF37"
        android:textSize="17sp"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <TextView
            android:id="@+id/update_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F4F0DF"
            android:textSize="20sp"
            android:lineSpacingExtra="8dp"
            android:fontFamily="sans"
            android:paddingBottom="8dp" />
    </ScrollView>

    <TextView
        android:id="@+id/update_storage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:padding="16dp"
        android:background="@drawable/update_dialog_chip"
        android:text="✓ Your account data stays on the server and is not cleared by an update."
        android:textColor="#D9E7D1"
        android:textSize="16sp"
        android:lineSpacingExtra="3dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="end|center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/update_later"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:gravity="center"
            android:paddingLeft="22dp"
            android:paddingRight="22dp"
            android:text="LATER"
            android:textColor="#D4AF37"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/update_install"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:paddingLeft="24dp"
            android:paddingRight="24dp"
            android:text="DOWNLOAD &amp; INSTALL"
            android:textColor="#11100A"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/update_dialog_chip" />
    </LinearLayout>
</LinearLayout>