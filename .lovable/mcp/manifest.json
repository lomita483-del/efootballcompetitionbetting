          "type": "object",
          "properties": {
            "status": {
              "description": "Filter by ticket status.",
              "type": "string",
              "enum": [
                "open",
                "won",
                "lost",
                "void",
                "cashed_out"
              ]
            },
            "limit": {
              "description": "Max tickets to return (default 20, max 100).",
