      {
        "name": "admin_manage_bet",
        "title": "Admin manage bet",
        "description": "Suspend, reactivate, refund, void or delete a bet ticket using audited administrator-only operations.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": false,
