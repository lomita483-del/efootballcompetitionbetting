      {
        "name": "admin_manage_match",
        "title": "Admin manage match",
        "description": "Start, reschedule, score, settle, void, unvoid or archive a match using the same administrator permissions as the console.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "match_id": {
              "type": "string",
              "description": "Match UUID."
            },
            "action": {
              "type": "string",
              "enum": [
                "start",
                "cancel",
                "reschedule",
                "update_score",
                "end_and_settle",
                "void",
                "unvoid",
                "archive",
                "lock_betting",
                "unlock_betting",
                "set_presence"
              ],
              "description": "Administrative action."
            },
            "home_score": {
              "description": "Home score for score or settlement actions.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "away_score": {
              "description": "Away score for score or settlement actions.",
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "start_time": {
              "description": "ISO date-time for rescheduling.",
              "type": "string"
            },
            "reason": {
              "description": "Reason recorded for voiding or administrative traceability.",
              "type": "string"
            },
            "side": {
              "description": "Required by set_presence.",
              "type": "string",
              "enum": [
                "home",
                "away"
              ]
            },
            "present": {
              "description": "Attendance value required by set_presence.",
              "type": "boolean"
            }
          },
          "required": [
            "match_id",
            "action"
          ]
        },
        "outputSchema": null
      },
      {
